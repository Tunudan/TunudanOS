/* Thème LXQt « dark » (LGPL-2.1-or-later) recoloré Tunudan */
/*
 * General panel settings
 */

LXQtPanel #BackgroundWidget {
    background: rgba(13, 13, 13, 92%);
}

QToolTip {
    border: 1px solid #2A2A2C;
    background: #1C1C1E;
    padding: 2px;
    margin: 0px;
    color: #F5F1EA
}

/*
 * General plugins settings
 */

Plugin,
LXQtPanelPlugin {
    padding: 0;
    spacing: 20px;
    qproperty-moveMarkerColor: #FF6B1A;
}

Plugin > QWidget,
Plugin > QWidget > QWidget {
    color: #F5F1EA;
}

Plugin > QToolButton,
Plugin > QWidget > QToolButton,
Plugin > QWidget > QToolButton > QWidget > QToolButton,
LXQtPanelPlugin > QToolButton {
    margin: 0;
    border: 1px solid transparent;
    qproperty-iconSize: 24px;
    color: #F5F1EA;
}

Plugin > QToolButton:hover,
Plugin > QWidget > QToolButton:hover,
LXQtPanelPlugin > QToolButton:hover {
    border: 1px solid rgba(13, 13, 13, 92%);
    background: rgba(255, 107, 26, 30%);
}

Plugin > QToolButton:pressed,
Plugin > QWidget > QToolButton:pressed,
LXQtPanelPlugin > QToolButton:pressed {
    padding: 4px;
}

/*
 * Volume plugin
 */
VolumePopup, VolumePopup  QScrollArea, VolumePopup QWidget {
    background: #2A2A2C;
    color: #F5F1EA;
    padding: 0 2px;
}

VolumePopup QPushButton {
    border: 1px solid rgba(255, 255, 255, 5%);
    border-radius: 2px;
    color: #F5F1EA;
    background: rgba(255, 255, 255, 10%);
    padding: 2px;
    margin: 2px;
    qproperty-iconSize: 24px;
}

VolumePopup QPushButton:hover, VolumePopup QPushButton:on {
    border: 1px solid rgba(255, 107, 26, 45%);
    border-radius: 2px;
    background: rgba(255, 107, 26, 60%);
}

VolumePopup QSlider::groove:horizontal {
    height: 6px;
    border-radius: 2px;
}

VolumePopup QSlider::handle:horizontal {
     width: 10px;
     background: #C2C2C2;
     border-radius: 3px;
     margin: -5px 0; /* expand outside the groove */
}

VolumePopup QSlider::sub-page {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
            stop: 0 #787676, stop: 1 #ABABAB);
    border: 1px solid rgba(28, 28, 30, 96%);
    border-radius: 3px;
}

VolumePopup QSlider::add-page {
    background: rgba(28, 28, 30, 96%);
    border-radius: 3px;
}

/*
 *Backlight Plugin
 */
#Backlight QToolButton {
    color: #f2f1f0;
    background: #363532;
    padding: 2px;
    margin: 1px;
    qproperty-iconSize: 24px;
}

#Backlight QToolButton:pressed {
    padding: 4px;
}

#Backlight QToolButton:hover {
    border: 1px solid rgba(255, 255, 255, 10%);
    border-radius: 2px;
    background: rgba(255, 107, 26, 30%);
}

#Backlight > SliderDialog {
    background: #2A2A2C;
}

#Backlight > SliderDialog > QSlider::groove:vertical {
    background: #2A2A2C;
    width: 5px;
    border-radius: 3px;
}

#Backlight > SliderDialog > QSlider::handle:vertical {
    height: 10px;
    background: #F5F1EA;
    border-radius: 4px;
    margin: 0 -4px; /* expand outside the groove */
}

#Backlight > SliderDialog > QSlider::add-page:vertical {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
            stop: 0 #787676, stop: 1 #ABABAB);
    border: 1px solid rgba(28, 28, 30, 96%);
    border-radius: 3px;
}

#Backlight > SliderDialog > QSlider::sub-page:vertical {
    background: rgba(28, 28, 30, 96%);
}

/*
 * Desktopswitch
 */
#DesktopSwitch QToolButton:hover {
    border: 1px solid rgba(13, 13, 13, 92%);
    background: rgba(255, 107, 26, 30%);
}

#DesktopSwitch QToolButton:on {
    background: #FF6B1A;
    border: 1px solid #FF6B1A;
    font: bold;
}

#DesktopSwitch QToolButton:hover:on {
    background: #FF9A5C;
    border: 1px solid #FF9A5C;
}

#DesktopSwitch QToolButton:pressed {
    background: #50080a;
    padding: 4px;
}

#DesktopSwitch QToolButton[urgent="true"] {
    color: white;
    background: #960f11;
    border: 1px solid #FF6B1A;
}

/*
 * QuickLaunch
 */
#QuickLaunchPlaceHolder {
    color: #AAAAAA;
    padding: 0 5px;
}

#QuickLaunch QToolButton {
    border: 0px;
    padding: 2px;
}

#QuickLaunch QToolButton:hover {
    border: 1px solid rgba(13, 13, 13, 92%);
    background: rgba(255, 107, 26, 30%);
}

#QuickLaunch QToolButton:pressed {
    padding: 4px;
}

/*
 * TaskBar
 */
#TaskBar QToolButton {
    margin: 2px;
    padding: 2px;
}

#TaskBar QToolButton:on {
    border: 1px solid rgba(13, 13, 13, 92%);
    background: rgba(13, 13, 13, 70%);
}

#TaskBar QToolButton:hover {
    border: 1px solid rgba(13, 13, 13, 92%);
    background: rgba(255, 107, 26, 30%);
}

#TaskBar QToolButton:pressed {
    padding: 4px;
}

#TaskBar QToolButton[urgent="true"] {
    color: palette(highlighted-text);
    background: palette(highlight);
}

#TaskBar LXQtGroupPopup {
    background: rgba(13, 13, 13, 92%);
    border: 1px solid rgba(13, 13, 13, 70%);
    ;
}

#TaskBar LXQtGroupPopup QToolButton {
    margin: 0;
}

/*
 * Calendar Widget
 */
QCalendarWidget QAbstractItemView:enabled {
    color: white;
    background: black;
    selection-background-color: #FF6B1A;
    selection-color: white;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #969696;
}

QCalendarWidget QWidget {
    alternate-background-color: #2A2A2C;
}

QCalendarWidget #qt_calendar_navigationbar,
QCalendarWidget #qt_calendar_navigationbar * {
    background-color: #2A2A2C;
    color: #F5F1EA;
}

QCalendarWidget #qt_calendar_monthbutton {
    padding: 2px;
    margin: 2px;
}

QCalendarWidget #qt_calendar_monthbutton:hover {
    border: 1px solid rgba(13, 13, 13, 92%);
    background: rgba(255, 107, 26, 30%);
}

QCalendarWidget #qt_calendar_monthbutton::menu-indicator {
    image: none;
}

QCalendarWidget QTableView {
    selection-background-color: #2A2A2C;
}

QCalendarWidget #qt_calendar_nextmonth {
    max-height: 20px;
    min-height: 20px;
    qproperty-icon: url(calendar-popup/right-arrow.svg);
}

QCalendarWidget #qt_calendar_prevmonth {
    max-height: 20px;
    min-height: 20px;
    qproperty-icon: url(calendar-popup/left-arrow.svg);
}

/*
 * Clock
 */
#Clock:hover {
    border: 1px solid rgba(13, 13, 13, 92%);
    background: rgba(255, 107, 26, 30%);
}

#Clock > QWidget {
    margin: 2px;
}

#Clock #TimeLabel {
    color: #F5F1EA;
    margin-right: 2px;
    margin-left: 2px;
}

#Clock #DateLabel {
    color: #F5F1EA;
    margin-right: 2px;
    margin-left: 2px;
}

/*
 * Tray
 */
#Tray {
    min-width: 6px;
    padding-left: 2px;
    padding-right: 2px;
}

TrayIcon {
    margin: 2px;
}

/*
 * All menus
 */

QMenu {
    margin: 0px;
    padding: 2px;
    border: 1px solid rgba(28, 28, 30, 92%);
    border-bottom-color: rgba(28, 28, 30, 96%);
    border-right-color: rgba(28, 28, 30, 96%);
    background: rgba(28, 28, 30, 96%);
    color: white;
}

QMenu::icon {
    background-color: transparent;
    border: 20px;
}

QMenu QToolButton {
    background-color: #2A2A2C;
    padding: 5px;
    border: none;
    color: white;
    font: bold italic;
}

QMenu::separator {
    background-color: #4c4c4c;
    height: 1px;
}

QMenu::item {
    border: 10px solid transparent;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 5px;
    padding: 6px;
    background: transparent;
    color: white;
}

QMenu::item:selected {
    border: 10px solid #FF6B1A;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 5px;
    background: #FF6B1A;
    color: white;
}

QMenu::item:selected:disabled {
    background-color: palette(text);
}

QMenu::item:disabled {
    color: #6D6D6D;
    background-color: transparent;
}

QMenu::right-arrow {
    image: url(arrow-right.svg);
}

QMenu::left-arrow {
    image: url(arrow-left.svg);
}

QMenu::indicator {
    width: 13px;
    height: 13px;
}

QMenu::indicator:non-exclusive:unchecked {
    image: url(unchecked.svg);
}

QMenu::indicator:non-exclusive:checked {
    image: url(checked.svg);
}

/*
 * Main menu
 */

#MainMenu {
    margin: 2px;
    padding: 2px;
    border: none;
    background: rgba(28, 28, 30, 96%);
    qproperty-icon: url(mainmenu.png);
    color: white;
}

#MainMenu QLineEdit {
    background: black;
    border: 1px solid #2A2A2C;
    border-bottom-width: 0px;
    border-right-width: 0px;
    border-left-width: 0px;
    padding: 3px;
    margin-bottom: 1px;
    color: white;
    selection-background-color: #FF6B1A;
}

#MainMenu ActionView {
    border: none;
    background: black;
    color: white;
}

#MainMenu ActionView::item {
    background: black;
    color: white;
    border: none;
    padding: 4px 3px 4px 10px;
}

#MainMenu ActionView::item:hover {
    background: #C2410C;
    color: white;
}

#MainMenu ActionView::item:selected {
    background: #FF6B1A;
    color: white;
}

/*
 * Fancy menu
 */
#FancyMenu {
    margin: 2px;
    padding: 2px;
    border: none;
    background: rgba(28, 28, 30, 96%);
    qproperty-icon: url(mainmenu.png);
    color: white;
}

LXQtFancyMenuWindow {
    background: rgba(0, 0, 0, 0%);/*disabled transparency because buggy*/
}

#FancyMenu QLabel {
    color: white;
}

#FancyMenu QLineEdit {
    background: black;
    border: 1px solid #2A2A2C;
    padding: 3px;
    margin-bottom: 1px;
    color: white;
    selection-background-color: #FF6B1A;
}

#FancyMenu #AppView {
    border: 1px solid grey;
    background: rgba(13, 13, 13, 60%);
    color: white;
}

#FancyMenu QListView::item {
    color: white;
    border: none;
    padding: 4px 3px 4px 10px;
}

#FancyMenu QListView::item:hover {
    background: #960d12;
    color: white;
}

#FancyMenu QListView::item:selected {
    background: #810b0f;
    color: white;
}

#FancyMenu QListView::focus {
    outline:transparent;
    padding: 0px;
}

#FancyMenu QToolButton {
    margin: 3px;
    border-radius: 4px;
    border: 1px solid #2A2A2C;
    padding: 4px;
    background: transparent;
}

#FancyMenu QToolButton:hover,
#FancyMenu QToolButton:focus {
    background: #C2410C;
    border: 1px solid grey;
}

#FancyMenu QToolButton:pressed {
    background: #FF6B1A;
}

#FancyMenu QScrollBar:vertical {
    background-color: transparent;
    width: 15px;
    margin: 2px 2px 2px 2px;
    border: 1px solid transparent;
}

#FancyMenu QScrollBar:horizontal {
    background-color: transparent;
    height: 15px;
    margin: 2px 2px 2px 2px;
    border: 1px solid transparent;
}

#FancyMenu QScrollBar::handle:vertical {
    background-color: #FF6B1A;
    border: 0px solid #FF6B1A;
    min-height: 40px;
    border-radius: 3px;
    margin: 1px;
}

#FancyMenu QScrollBar::handle:horizontal {
    background-color: #FF6B1A;
    border: 0px solid #FF6B1A;
    min-width: 40px;
    border-radius: 3px;
    margin: 1px;
}

#FancyMenu QScrollBar::handle:hover{
    background-color: #FF9A5C;
    border: 1px solid #FF9A5C;
    margin: 0px;
}

#FancyMenu QScrollBar::add-line:vertical,
#FancyMenu QScrollBar::sub-line:vertical {
    border: 0px solid transparent;
    background: transparent;
    width: 0px;
}

#FancyMenu QScrollBar::add-line:horizontal,
#FancyMenu QScrollBar::sub-line:horizontal {
    border: 0px solid transparent;
    background: transparent;
    width: 0px;
}

#FancyMenu QAbstractScrollArea::corner {
    background: transparent;
}

/*
 * Mount plugin
 */
#LXQtMountPlugin QToolButton {
    padding: 2px;
}

#LXQtMountPopup {
    background-color: #2A2A2C;
    padding: 4px;
}

#LXQtMountPopup > MenuDiskItem {
    border-radius: 4px;
}

#LXQtMountPopup > MenuDiskItem:hover {
    border: 1px solid rgba(13, 13, 13, 92%);
    background: rgba(255, 107, 26, 30%);
}

#LXQtMountPopup #EjectButton,
#LXQtMountPopup #DiskButton {
    qproperty-iconSize: 22px;
    background-color: transparent;
    border: none;
    color: #F5F1EA;
    padding: 4px;
}

#LXQtMountPopup #NoDiskLabel {
    margin: 6px;
    color: #CCCCCC;
}


/*
 * ShowDesktop
 */
#ShowDesktop > QToolButton:hover {
    border: 1px solid rgba(13, 13, 13, 92%);
    background: rgba(255, 107, 26, 30%);
}

/*
 * KbIndicator
 */
#KbIndicator > QLabel {
    padding: 3px;
    border: 0px;
    font: bold;
}

#KbIndicator > QLabel:disabled {
    color: #b4b4b4;
}

#KbIndicator > QLabel:enabled {
    color: white;
    background: #780d0f;
}

/*
 * SysStat
 */
#SysStat {
    padding: 2px 2px 2px 2px;
    margin: 2px;
}

#SysStat > QLabel {
    font-size: 6pt;
}

#SysStat_Graph {
    qproperty-gridColor: rgba(255, 107, 26, 38%);
    qproperty-titleColor: rgba(255, 255, 255, 75%);
    qproperty-cpuSystemColor: rgb(128, 0, 0);
    qproperty-cpuUserColor: rgb(0, 0, 128);
    qproperty-cpuNiceColor: rgb(0, 128, 0);
    qproperty-cpuOtherColor: rgb(128, 128, 0);
    qproperty-frequencyColor: rgb(96, 96, 96);
    qproperty-memAppsColor: rgb(0, 0, 128);
    qproperty-memBuffersColor: rgb(0, 128, 0);
    qproperty-memCachedColor: rgb(128, 128, 0);
    qproperty-swapUsedColor: rgb(128, 0, 0);
    qproperty-netReceivedColor: rgb(0, 0, 128);
    qproperty-netTransmittedColor: rgb(128, 128, 0);
}

/*
 * WorldClock
 */
#WorldClock:hover {
    border: 1px solid rgba(13, 13, 13, 92%);
    background: rgba(255, 107, 26, 30%);
}

#WorldClockContent {
    margin-right: 2px;
    margin-left: 2px;
    padding: 2px;
    color: #F5F1EA;
    background: transparent;
}

/*
 * CPU monitor
 */
#LXQtCpuLoad {
    qproperty-fontColor: #F5F1EA;
}

/*
 * Spacer
 */
#Spacer {
    background-position: center center;
}

#Spacer[type="lined"] {
    background-image: url(/spacer-plugin/spacer-line.svg);
}

#Spacer[type="dotted"] {
    background-image: url(/spacer-plugin/spacer-dots.svg);
}

#Spacer[orientation="horizontal"] {
    background-repeat: repeat-y;
    margin-top: 2px;
    margin-bottom: 2px;
}

#Spacer[orientation="vertical"] {
    background-repeat: repeat-x;
    margin-right: 2px;
    margin-left: 2px;
}
