# Thème Tunudan — généré par themes/build.py, ne pas modifier à la main — dunst (i3)
[global]
font = Inter 11
width = 360
offset = 16x16
origin = top-right
padding = 12
horizontal_padding = 14
frame_width = 2
frame_color = "#FF6B1A"
separator_color = frame
corner_radius = 12
icon_corner_radius = 6
background = "#1C1C1E"
foreground = "#F5F1EA"
highlight = "#FF6B1A"

[urgency_low]
background = "#141416"
foreground = "#BDB7AE"
frame_color = "#2A2A2C"
timeout = 5

[urgency_normal]
background = "#1C1C1E"
foreground = "#F5F1EA"
frame_color = "#FF6B1A"
timeout = 8

[urgency_critical]
background = "#1C1C1E"
foreground = "#F5F1EA"
frame_color = "#ED553B"
timeout = 0
