[Desktop Entry]
Type=Application
Name=Thème Tunudan
Comment=Applique le thème Tunudan à la première ouverture de session sur chaque bureau
Exec=tunudan-theme apply --auto
Icon=tunudan
NoDisplay=true
Terminal=false
X-GNOME-Autostart-Phase=Applications
X-GNOME-Autostart-Delay=2
X-KDE-autostart-phase=2
