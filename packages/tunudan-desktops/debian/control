Rules-Requires-Root: no

Package: tunudan-desktop-gnome
Architecture: all
Depends: ${misc:Depends}, tunudan-theme, tunudan-tools, gnome-core, gdm3, gnome-tweaks,
 gnome-shell-extension-appindicator, file-roller, network-manager-gnome
Recommends: gnome-shell-extension-dashtodock, gnome-software-plugin-flatpak, dconf-cli
Description: Tunudan OS — bureau GNOME
 GNOME, épuré et moderne, au thème Tunudan (accent orange, fonds origami
 jour/nuit, icônes et curseurs Tunudan). Écran de connexion GDM.

Package: tunudan-desktop-plasma
Architecture: all
Depends: ${misc:Depends}, tunudan-theme, tunudan-tools, kde-plasma-desktop, sddm,
 qml6-module-qtquick-controls, qml6-module-qtquick-layouts, konsole, dolphin,
 kate, okular, gwenview, ark, spectacle, plasma-nm, plasma-pa, kde-config-gtk-style,
 kde-config-sddm
Recommends: plasma-discover, plasma-discover-backend-flatpak, kde-config-flatpak,
 kwalletmanager, partitionmanager, kcalc
Description: Tunudan OS — bureau KDE Plasma
 KDE Plasma 6 avec le thème global Tunudan (couleurs TunudanDark, panneau
 en bas, profil Konsole orange). Écran de connexion SDDM Tunudan.

Package: tunudan-desktop-xfce
Architecture: all
Depends: ${misc:Depends}, tunudan-theme, tunudan-tools, xfce4, xfce4-whiskermenu-plugin,
