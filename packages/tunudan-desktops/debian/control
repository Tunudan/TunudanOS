Package: tunudan-desktop-sway
Architecture: all
Depends: ${misc:Depends}, tunudan-theme, tunudan-tools, sway, swaybg, swayidle,
 swaylock, waybar, foot, fuzzel, mako-notifier, grim, slurp, wl-clipboard,
