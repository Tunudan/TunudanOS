#!/usr/bin/python3
"""tunudan-update — état et lancement des mises à jour, en langage simple.

  tunudan-update            fenêtre (ou texte sans écran)
  tunudan-update status     état en une ligne (code retour 0 = à jour)
  tunudan-update now        mettre à jour maintenant (demande le mot de passe)
  tunudan-update notify     notification si un redémarrage est nécessaire
"""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/lib/tunudan")
import tunudan_common as tc  # noqa: E402

REBOOT_FLAG = "/var/run/reboot-required"
ROOT_HELPER = "/usr/lib/tunudan/tunudan-update-root"


def pending_count() -> int:
    """Nombre de paquets à mettre à jour (simulation, sans droits root)."""
    if tc.which("apt-get"):
        r = tc.run(["apt-get", "-s", "-o", "Debug::NoLocking=1", "dist-upgrade"])
        return sum(1 for line in r.stdout.splitlines() if line.startswith("Inst "))
    if tc.which("checkupdates"):  # Arch (pacman-contrib)
        r = tc.run(["checkupdates"])
        return len([x for x in r.stdout.splitlines() if x.strip()])
    return 0


def status() -> tuple:
    if os.path.exists(REBOOT_FLAG):
        return "reboot", "Redémarrez l'ordinateur pour terminer les mises à jour."
    n = pending_count()
    if n:
        return "pending", f"{n} mise(s) à jour disponible(s)."
    return "ok", "Votre ordinateur est à jour."


def update_now() -> int:
    cmd = [ROOT_HELPER] if os.geteuid() == 0 else ["pkexec", ROOT_HELPER]
    return subprocess.call(cmd)


def notify() -> int:
    state, msg = status()
    if state == "ok" or not tc.which("notify-send"):
        return 0
    urgency = "critical" if state == "reboot" else "normal"
    subprocess.call(["notify-send", "-u", urgency, "-i", "tunudan",
                     "-a", "Tunudan OS", "Mises à jour", msg])
    return 0


def gui() -> int:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gdk, GLib, Gtk
    import threading

    tc.apply_css(Gtk, Gdk)
    win = Gtk.Window(title="Mises à jour")
    win.set_default_size(480, 300)
    win.set_position(Gtk.WindowPosition.CENTER)
    win.set_icon_name("tunudan")
    win.connect("destroy", Gtk.main_quit)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, margin=28)
    win.add(box)
    title = Gtk.Label(label="Mises à jour")
    title.get_style_context().add_class("tunudan-title")
    box.pack_start(title, False, False, 0)
    lbl = Gtk.Label(label="Vérification…")
    lbl.get_style_context().add_class("tunudan-big")
    lbl.set_line_wrap(True)
    box.pack_start(lbl, False, False, 0)
    spinner = Gtk.Spinner()
    box.pack_start(spinner, False, False, 0)
    btn = Gtk.Button(label="Mettre à jour maintenant")
    btn.get_style_context().add_class("tunudan-cta")
    current = {"state": ""}
    btn.set_sensitive(False)
    box.pack_end(btn, False, False, 0)

    def refresh():
        state, msg = status()
        lbl.set_text(msg)
        btn.set_label("Redémarrer" if state == "reboot" else "Mettre à jour maintenant")
        btn.set_sensitive(state != "ok")
        btn.set_visible(state != "ok")
        current["state"] = state
        return False

    def worker():
        update_now()
        GLib.idle_add(done)

    def done():
        spinner.stop()
        refresh()
        return False

    def on_click(_b):
        if current["state"] == "reboot":
            subprocess.call(["systemctl", "reboot"])
            return
        btn.set_sensitive(False)
        lbl.set_text("Mise à jour en cours, vous pouvez continuer à travailler…")
        spinner.start()
        threading.Thread(target=worker, daemon=True).start()

    btn.connect("clicked", on_click)
    win.show_all()
    GLib.idle_add(refresh)
    Gtk.main()
    return 0


def main() -> int:
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "status":
        state, msg = status()
        print(msg)
        return 0 if state == "ok" else 1
    if arg == "now":
        return update_now()
    if arg == "notify":
        return notify()
    if arg in ("-h", "--help"):
        print(__doc__)
        return 0
    if tc.gtk_available():
        return gui()
    state, msg = status()
    print(msg)
    if state == "pending" and input("Mettre à jour maintenant ? [O/n] ").strip().lower() in ("", "o", "oui"):
        return update_now()
    return 0


if __name__ == "__main__":
    sys.exit(main())
