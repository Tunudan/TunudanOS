#!/bin/sh
# tunudan-theme — applique le thème Tunudan à votre session.
#
#   tunudan-theme apply            applique le thème au bureau en cours
#   tunudan-theme apply xfce       … ou à un bureau précis
#   tunudan-theme apply --auto     (ouverture de session) une seule fois par bureau
#   tunudan-theme status           bureaux déjà thémés pour ce compte
#   tunudan-theme reset            oublie l'historique (le thème sera réappliqué)
#
# Le thème est installé dans le système (/usr/share) : cette commande ne fait que
# régler votre compte. Vos propres réglages restent modifiables à tout moment.
set -eu
PACK=/usr/share/tunudan/themes
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/tunudan"
LOG="$STATE/theme.log"

detect() {
    d=$(printf '%s:%s' "${XDG_CURRENT_DESKTOP:-}" "${DESKTOP_SESSION:-}" | tr '[:upper:]' '[:lower:]')
    case "$d" in
        *budgie*) echo budgie ;;
        *cosmic*) echo cosmic ;;
        *cinnamon*) echo cinnamon ;;
        *kde*|*plasma*) echo plasma ;;
        *xfce*) echo xfce ;;
        *mate*) echo mate ;;
        *lxqt*) echo lxqt ;;
        *hyprland*) echo hyprland ;;
        *sway*) echo sway ;;
        *i3*) echo i3 ;;
        *niri*) echo niri ;;
        *gnome*|*ubuntu*) echo gnome ;;
    esac
}

# Les gestionnaires en mosaïque sont déjà thémés par leurs fichiers de /etc/skel :
# on ne touche pas à une configuration qui inclut déjà Tunudan.
already_in_config() {
    c="${XDG_CONFIG_HOME:-$HOME/.config}"
    case "$1" in
        i3) grep -qs tunudan "$c/i3/config" "$HOME/.i3/config" ;;
        sway) grep -qs tunudan "$c/sway/config" ;;
        hyprland) grep -qs tunudan "$c/hypr/hyprland.lua" "$c/hypr/hyprland.conf" ;;
        niri) true ;;
        *) false ;;
    esac
}

apply() {
    auto=0; de=""
    for a in "$@"; do
        case "$a" in
            --auto) auto=1 ;;
            *) de=$a ;;
        esac
    done
    [ -n "$de" ] || de=$(detect)
    if [ -z "$de" ]; then
        echo "Bureau non détecté. Exemple : tunudan-theme apply xfce" >&2
        exit 2
    fi
    mkdir -p "$STATE"
    if [ "$auto" = 1 ]; then
        [ -f "$STATE/theme-$de" ] && exit 0
        if already_in_config "$de"; then touch "$STATE/theme-$de"; exit 0; fi
        [ "$de" = niri ] && exit 0
    fi
    [ "$de" = niri ] && { echo "niri : le thème est dans ~/.config/niri/config.kdl"; exit 0; }
    {
        echo "== $(date '+%F %T') : $de"
        TUNUDAN_SYSTEM=1 sh "$PACK/install.sh" "$de"
    } >> "$LOG" 2>&1 || { echo "Échec, détails dans $LOG" >&2; exit 1; }
    touch "$STATE/theme-$de"
    [ "$auto" = 1 ] || echo "Thème Tunudan appliqué ($de). Détails : $LOG"
}

case "${1:-}" in
    apply) shift; apply "$@" ;;
    status)
        mkdir -p "$STATE"
        echo "Bureau actuel : $(detect || true)"
        printf 'Déjà thémés : '; (cd "$STATE" && ls theme-* 2>/dev/null | sed 's/^theme-//' | tr '\n' ' '); echo ;;
    reset) rm -f "$STATE"/theme-*; echo "Historique effacé : le thème sera réappliqué à la prochaine session." ;;
    *) sed -n '2,11p' "$0"; [ -z "${1:-}" ] || exit 2 ;;
esac
