# Tunudan : réglages par défaut des bureaux GNOME, Cinnamon, MATE et Budgie.
# Nommé « zz-… » pour passer après mint-artwork et desktop-base (ordre alphabétique).
# Les clés absentes d'une version du bureau sont ignorées par glib-compile-schemas.
# Chaque utilisateur peut changer ces valeurs : ce ne sont que des valeurs par défaut.

[org.gnome.desktop.interface]
gtk-theme='Tunudan'
icon-theme='Tunudan'
cursor-theme='Tunudan-cursors'
cursor-size=24
color-scheme='prefer-dark'
accent-color='orange'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrains Mono 11'

[org.gnome.desktop.wm.preferences]
titlebar-font='Inter Bold 11'
button-layout='appmenu:minimize,maximize,close'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/tunudan/origami/origami-grue-clair.png'
picture-uri-dark='file:///usr/share/backgrounds/tunudan/origami/origami-grue-sombre.png'
picture-options='zoom'
primary-color='#0D0D0D'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/tunudan/origami/origami-grue-sombre.png'
primary-color='#0D0D0D'

[org.cinnamon.desktop.interface]
gtk-theme='Tunudan'
icon-theme='Tunudan'
cursor-theme='Tunudan-cursors'
cursor-size=24
font-name='Inter 10'

[org.cinnamon.desktop.wm.preferences]
theme='Tunudan'
titlebar-font='Inter Bold 10'

[org.cinnamon.theme]
name='Tunudan'

[org.cinnamon.desktop.background]
picture-uri='file:///usr/share/backgrounds/tunudan/origami/origami-grue-sombre.png'
picture-options='zoom'

[org.x.apps.portal]
color-scheme='prefer-dark'

[org.mate.interface]
gtk-theme='Tunudan'
icon-theme='Tunudan'
font-name='Inter 10'
document-font-name='Inter 10'
monospace-font-name='JetBrains Mono 11'

[org.mate.Marco.general]
theme='Tunudan'
titlebar-font='Inter Bold 10'

[org.mate.peripherals-mouse]
cursor-theme='Tunudan-cursors'
cursor-size=24

[org.mate.background]
picture-filename='/usr/share/backgrounds/tunudan/origami/origami-grue-sombre.png'
picture-options='zoom'

[com.solus-project.budgie-panel]
dark-theme=true
builtin-theme=false

[x.dm.slick-greeter]
background='/usr/share/backgrounds/tunudan/origami/origami-grue-sombre.png'
background-color='#0D0D0D'
draw-user-backgrounds=false
theme-name='Tunudan'
icon-theme-name='Tunudan'
cursor-theme-name='Tunudan-cursors'
font-name='Inter 11'
logo='/usr/share/tunudan/login/tunudan-wordmark.png'
