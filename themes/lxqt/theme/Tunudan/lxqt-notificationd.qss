/* Thème LXQt « dark » (LGPL-2.1-or-later) recoloré Tunudan */
Notification {
    color: #F5F1EA;
    border: 1px solid rgba(13, 13, 13, 92%);
    background:rgba(28, 28, 30, 96%);
    margin: 0px;
}

QLabel {
    color: #FFFFFF;
}

#closeButton {
    border: none;
    padding: 2px;
    qproperty-icon: url(lxqt-notificationd/cancel.svg);
}

#closeButton:hover {
    border: 1px solid rgba(13, 13, 13, 92%);
    padding: 2px;
    background: rgba(255, 107, 26, 30%);
    qproperty-icon: url(lxqt-notificationd/cancel.png);
}

#appLabel {
    font-weight: bold;
}
