#!/bin/sh
# Note l'édition et la version dans la configuration Tunudan.
set -e
sed -i 's/^nom = .*/nom = @EDITION@/' /etc/tunudan/tunudan.conf
sed -i -e 's/^VERSION_ID=.*/VERSION_ID="@VERSION@"/' \
       -e 's/^VERSION=.*/VERSION="@VERSION@ (trixie)"/' \
       -e 's/^PRETTY_NAME=.*/PRETTY_NAME="Tunudan OS @VERSION@ (base Debian 13 trixie)"/' \
       /usr/lib/tunudan/os-release
echo "@EDITION@" > /etc/tunudan/edition
