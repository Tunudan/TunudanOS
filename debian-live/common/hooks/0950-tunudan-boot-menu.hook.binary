#!/bin/sh
# Menu de démarrage de l'ISO (exécuté dans binary/, après la génération des menus) :
# libellés Tunudan au lieu de « Live system », démarrage automatique après 10 s.
set -e
LABEL="Tunudan OS @EDITION_LABEL@"

find boot/grub isolinux -name '*.cfg' 2>/dev/null | while read -r f; do
    sed -i "s/Live system/$LABEL/g" "$f"
done

if [ -f boot/grub/config.cfg ] && ! grep -q '^set timeout=' boot/grub/config.cfg; then
    sed -i '1a set timeout=10' boot/grub/config.cfg
fi
if [ -f isolinux/isolinux.cfg ]; then
    sed -i 's/^timeout 0$/timeout 100/' isolinux/isolinux.cfg
fi
